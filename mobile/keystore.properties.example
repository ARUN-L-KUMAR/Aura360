# Template for mobile/keystore.properties (which is gitignored - never commit the real file).
# Copy this file to keystore.properties and fill in YOUR upload keystore details.
# Full instructions: scripts/README.md
#
# Use forward slashes in paths (C:/...) - a single backslash is a Java properties escape.
# A relative storeFile is resolved against the mobile/ directory. Keep the keystore itself
# OUTSIDE the repository, and back it up somewhere safe: losing it can lock you out of updates.

storeFile=C:/Users/YOUR_NAME/.aura360-signing/aura360-upload.jks
storePassword=CHANGE_ME
keyAlias=aura360-upload
keyPassword=CHANGE_ME

# Alternative to this file: set AURA360_UPLOAD_STORE_FILE / AURA360_UPLOAD_STORE_PASSWORD /
# AURA360_UPLOAD_KEY_ALIAS / AURA360_UPLOAD_KEY_PASSWORD in the environment (they override this file).
